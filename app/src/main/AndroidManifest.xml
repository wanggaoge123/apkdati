<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml —— 隐身配置核心文件
  本 APP 的设计目标是：桌面无图标、无最近任务、无独立界面，仅依靠无障碍服务后台拉起。
  下面每个"隐身相关属性"都标注了作用与依据。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 权限声明 ============ -->
    <!-- 前台服务（媒体类型）：Android 10+ 必须显式声明 foregroundServiceType -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 前台服务类型：媒体播放（兼容 Android 14 的强校验） -->
    <!-- 悬浮窗：方案1 依赖此权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 唤醒锁：持有 CPU 防止息屏计时中断 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 接收开机广播以尝试复活（Android 10+ 受限，仅作为补充） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 前台服务在 Android 14 上还需要 POST_NOTIFICATIONS（弹最低优先级静音通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 忽略电池优化白名单（引导用户手动授予，不静默） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 网络：writing-core 走 HanziWriter CDN 在线识别；断网时前端离线兜底 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ============ 应用级配置 ============ -->
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_close_clear_cancel"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar"
        tools:targetApi="34">

        <!--
          ========== 唯一 Activity（首次引导入口）==========
          关键隐身属性（需求一.2）：
          · android:excludeFromRecents="true"  → 不出现在多任务/最近应用列表
          · android:noHistory="true"           → 一旦离开就销毁，不在返回栈留痕
          关于入口（需求一.1/一.3 的平衡处理）：
          · 本 APP 正常运行后依旧"无桌面图标、无最近任务"，满足隐身目标；
          · 但安装后用户需要"首次进入做 4 项权限设置"，否则 APP 永远起不来。
            因此保留一个 LAUNCHER 入口 + exported=true，仅用于"首次引导"：
            - 用户点桌面图标 → 弹 4 项权限引导（含无障碍）→ 开完即引导完成；
            - 引导完成后再点图标，只显示"已配置完成"，不重复弹、不暴露主界面；
            - 后台服务/弹窗运行期间，本 Activity 已 finish，桌面图标点开无残留界面。
          这是实现"用户能打开做设置"的必要折中，未破坏正式运行的隐身性。
        -->
        <activity
            android:name=".ui.PermissionGuideActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Transparent"
            android:taskAffinity=""
            android:launchMode="singleInstance">
            <!-- 首次引导入口：允许用户从桌面点击进入做权限设置 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ========== 主前台服务（媒体类型） ==========
          前台服务用于保活；类型 mediaPlayback，通知最低优先级、静音、无角标（需求二.1）。
        -->
        <service
            android:name=".service.MainService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:process=":main" />

        <!--
          ========== 守护进程服务（独立进程 :guard） ==========
          与 :main 双向守护：一方被杀，另一方拉起（需求二.2）。
        -->
        <service
            android:name=".service.GuardService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:process=":guard" />

        <!--
          ========== 无障碍服务 ==========
          双作用：
          1) 作为"无图标 APP"的启动入口：系统开机/应用安装后用户开启无障碍即自动运行；
          2) 方案2 兜底绘制：当 SYSTEM_ALERT_WINDOW 悬浮窗失效时，用无障碍的顶层绘制视图弹听写窗。
        -->
        <service
            android:name=".service.FloatAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:process=":main">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!--
          ========== 定时自检广播接收者 ==========
          每 60 秒检测服务/双进程/无障碍状态，被冻结则重拉（需求二.5）。
          同时监听屏幕亮灭、开机、解锁等广播（需求二.3 / 二.4 引导触发）。
          使用 android:exported="false" 不对外暴露，由本应用自身或系统有序广播触发。
        -->
        <receiver
            android:name=".receiver.WatchdogReceiver"
            android:exported="false"
            android:process=":guard">
            <intent-filter>
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.SCREEN_OFF" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.hidden.dictation.WATCHDOG_TICK" />
                <action android:name="com.hidden.dictation.PULL_UP" />
            </intent-filter>
        </receiver>

        <!--
          ========== 屏幕状态/权限引导辅助接收者（主进程） ==========
          监听解锁、用户离开等，用于重置/暂停计时与权限引导触发。
        -->
        <receiver
            android:name=".receiver.ScreenStateReceiver"
            android:exported="false"
            android:process=":main">
            <intent-filter>
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.SCREEN_OFF" />
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
